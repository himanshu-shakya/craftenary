// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  artisan
  tourist
}

enum VerificationStatus {
  unverified
  verified
  pending
  rejected
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

model Profile {
  id                  String          @id @default(uuid()) @db.Uuid
  fullName            String?         @map("full_name")
  avatarUrl           String?         @map("avatar_url")
  role                UserRole        @default(tourist)
  onboardingCompleted Boolean         @default(false) @map("onboarding_completed")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  artisanProfile      ArtisanProfile?
  touristProfile      TouristProfile?

  @@map("profiles")
}

model Craft {
  id                    String                 @id @default(uuid())
  name                  String                 @unique
  category              String?                @default("Heritage Art")
  description           String?
  icon                  String?
  imageUrl              String?                @map("image_url")
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  artisanProfiles       ArtisanProfile[]
  workshops             Workshop[]
  touristInterests      TouristCraftInterest[]

  @@map("crafts")
}

model ArtisanProfile {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  firstName          String             @map("first_name")
  lastName           String             @map("last_name")
  city               String
  state              String
  country            String             @default("India")
  address            String?
  craftId            String             @map("craft_id")
  bio                String?
  experienceYears    Int                @default(1) @map("experience_years")
  pricePerHour       Decimal            @default(0.00) @map("price_per_hour") @db.Decimal(10, 2)
  profileImageUrl    String?            @map("profile_image_url")
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile            Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  craft              Craft              @relation(fields: [craftId], references: [id], onDelete: Restrict)
  workshops          Workshop[]

  @@index([city])
  @@index([craftId])
  @@index([verificationStatus])
  @@map("artisan_profiles")
}

model TouristProfile {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String                 @unique @map("user_id") @db.Uuid
  firstName          String                 @map("first_name")
  lastName           String                 @map("last_name")
  gender             String
  city               String
  state              String
  country            String                 @default("India")
  profileImageUrl    String?                @map("profile_image_url")
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile            Profile                @relation(fields: [userId], references: [id], onDelete: Cascade)
  craftInterests     TouristCraftInterest[]
  bookings           Booking[]

  @@index([city])
  @@map("tourist_profiles")
}

model TouristCraftInterest {
  touristId String         @map("tourist_id") @db.Uuid
  craftId   String         @map("craft_id")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tourist   TouristProfile @relation(fields: [touristId], references: [id], onDelete: Cascade)
  craft     Craft          @relation(fields: [craftId], references: [id], onDelete: Cascade)

  @@id([touristId, craftId])
  @@index([touristId])
  @@index([craftId])
  @@map("tourist_craft_interests")
}

model Workshop {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artisanId       String          @map("artisan_id") @db.Uuid
  craftId         String          @map("craft_id")
  name            String
  description     String
  location        String
  city            String
  state           String
  price           Decimal         @default(0.00) @db.Decimal(10, 2)
  duration        String
  maxParticipants Int             @default(6) @map("max_participants")
  rating          Decimal         @default(5.0) @db.Decimal(3, 2)
  reviewsCount    Int             @default(0) @map("reviews_count")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  artisan         ArtisanProfile  @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  craft           Craft           @relation(fields: [craftId], references: [id], onDelete: Restrict)
  images          WorkshopImage[]
  bookings        Booking[]

  @@index([artisanId])
  @@index([craftId])
  @@index([city])
  @@index([isActive])
  @@map("workshops")
}

model WorkshopImage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workshopId   String   @map("workshop_id") @db.Uuid
  imageUrl     String   @map("image_url")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workshop     Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId])
  @@map("workshop_images")
}

model Booking {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  touristId      String         @map("tourist_id") @db.Uuid
  workshopId     String         @map("workshop_id") @db.Uuid
  bookingDate    String         @map("booking_date")
  timeSlot       String         @map("time_slot")
  numberOfPeople Int            @default(1) @map("number_of_people")
  totalPrice     Decimal        @default(0.00) @map("total_price") @db.Decimal(10, 2)
  status         BookingStatus  @default(confirmed)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tourist        TouristProfile @relation(fields: [touristId], references: [id], onDelete: Cascade)
  workshop       Workshop       @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([touristId])
  @@index([workshopId])
  @@index([status])
  @@map("bookings")
}
